{
  "pageName": "AuditHistoryPage",
  "methods": [
    {
      "name": "validateAuditHistoryHeader",
      "params": [],
      "returnType": "Promise<void>",
      "variables": {},
      "controlFlow": [],
      "steps": [
        {
          "order": 1,
          "type": "expect",
          "target": "this.auditHistoryHeader",
          "assertion": "toBeVisible",
          "value": null
        },
        {
          "order": 2,
          "type": "expect",
          "target": "this.auditHistoryHeader",
          "assertion": "toHaveText",
          "value": "Audit History"
        }
      ]
    },
    {
      "name": "validateBreadcrumbs",
      "params": [
        "planName"
      ],
      "returnType": "Promise<void>",
      "variables": {},
      "controlFlow": [],
      "steps": []
    },
    {
      "name": "validatePlanYears",
      "params": [],
      "returnType": "Promise<void>",
      "variables": {},
      "controlFlow": [],
      "steps": [
        {
          "order": 1,
          "type": "expect",
          "target": "this.planYearsContainer",
          "assertion": "toBeVisible",
          "value": null
        },
        {
          "order": 2,
          "type": "expect",
          "target": "this.planYearSyncedChip",
          "assertion": "toBeVisible",
          "value": null
        },
        {
          "order": 3,
          "type": "expect",
          "target": "this.planYearSyncedChipIcon",
          "assertion": "toHaveText",
          "value": "check"
        },
        {
          "order": 4,
          "type": "expect",
          "target": "this.planYearNotSyncedChip",
          "assertion": "toBeVisible",
          "value": null
        },
        {
          "order": 5,
          "type": "expect",
          "target": "this.planYearNotSyncedChipIcon",
          "assertion": "toHaveText",
          "value": "error_outline"
        },
        {
          "order": 6,
          "type": "expect",
          "target": "this.planYearSyncFailedChip",
          "assertion": "toBeVisible",
          "value": null
        },
        {
          "order": 7,
          "type": "expect",
          "target": "this.planYearSyncFailedChipIcon",
          "assertion": "toHaveText",
          "value": "close"
        }
      ]
    },
    {
      "name": "clickPlanYearChip",
      "params": [
        "chipType"
      ],
      "returnType": "Promise<void>",
      "variables": {
        "chip": "Locator"
      },
      "controlFlow": [
        {
          "type": "switch",
          "variable": "chipType",
          "cases": [
            {
              "value": "synced",
              "assignments": [
                {
                  "var": "chip",
                  "value": "this.planYearSyncedChip"
                }
              ]
            },
            {
              "value": "notSynced",
              "assignments": [
                {
                  "var": "chip",
                  "value": "this.planYearNotSyncedChip"
                }
              ]
            },
            {
              "value": "syncFailed",
              "assignments": [
                {
                  "var": "chip",
                  "value": "this.planYearSyncFailedChip"
                }
              ]
            }
          ],
          "default": "throw"
        }
      ],
      "steps": []
    },
    {
      "name": "validateHistoryDataVisible",
